[Unit]
Description=Sovereign Seed Commons Bridge (Edge Storefront)
After=network.target

[Service]
Type=simple
User=joshua445
WorkingDirectory=/home/joshua445/sovereign_workspace/sovereign-seed-commons
Environment=COMMONS_BRIDGE_PORT=7999
ExecStart=/usr/bin/python3 commons_bridge/bridge.py
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
